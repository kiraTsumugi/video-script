      "value": 2,
      "severity": "block"
    },
    {
      "id": "R_MAX_SHOT",
      "desc": "单镜时长不得超过 15 秒",
      "type": "shot_max_duration",
      "value": 15,
      "severity": "block"
    },
    {
      "id": "R_REQUIRE_CITE",
      "desc": "每个分镜必须引用至少一个素材来源",
      "type": "require_cite",
      "severity": "block"
    },
    {
      "id": "R_GROUNDED_NUMBER",
